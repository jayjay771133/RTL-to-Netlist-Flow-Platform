# =====================================================================
# env.sh.example : 환경 설정 예시
#   사용법 : cp env.sh.example env.sh  → 경로를 내 PC 에 맞게 수정
#            → source env.sh  → python runner.py <design>
# =====================================================================

# 툴 / 라이브러리를 설치한 폴더
export BF_ROOT=$HOME/backflow

# Yosys, Verilator (OSS CAD Suite), OpenSTA 실행 경로
export PATH=$BF_ROOT/tools/oss-cad-suite/bin:$BF_ROOT/tools/OpenSTA/build:$PATH

# Nangate45 Liberty 파일
export BF_LIB_NANGATE45=$BF_ROOT/tools/OpenROAD-flow-scripts/flow/platforms/nangate45/lib/NangateOpenCellLibrary_typical.lib

# Python 가상환경 (pyyaml)
source $BF_ROOT/venv/bin/activate
